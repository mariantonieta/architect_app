# =============================================================================
# ARCHITECT PROJECT - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all the environment variables needed to run the application.
# Copy this file to .env and fill in the actual values for your environment.

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database connection parameters
# Format: postgresql://username:password@host:port/database_name
USER_DB=architect_user
HOST_DB=localhost
PORT_DB=5433
USER_PASSWORD=your_password_here
NAME_DB=architect_db

# =============================================================================
# JWT & SECURITY CONFIGURATION
# =============================================================================
# Secret key for JWT token generation (use a secure random string)
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here

# JWT algorithm and token expiration settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Basic application settings
PROJECT_NAME=Architect Project

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================
# Google OAuth credentials for social login
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Email service settings for sending notifications and password resets
emails_enabled=true
EMAILS_FROM_NAME="Architect"
EMAILS_FROM_EMAIL=no-reply@architect.com

# SMTP server configuration
# For Gmail: smtp.gmail.com, port 587
# For Mailtrap (testing): sandbox.smtp.mailtrap.io, port 2525
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# =============================================================================
# MINIO CONFIGURATION (File Storage)
# =============================================================================
# MinIO object storage settings for file uploads
MINIO_ENDPOINT=localhost:9099
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET_NAME=public-bucket
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_password
